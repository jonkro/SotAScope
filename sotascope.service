[Unit]
Description=SotAScope — research literature dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# Run as the user who owns the application directory.
# Replace with the actual username if different.
User=%i
Group=%i

# Adjust this to wherever you cloned the repo.
WorkingDirectory=/path/to/SotAScope

# env file lives inside the repo directory so the user owns it.
# Copy env.example to env and fill in the values before starting.
EnvironmentFile=/path/to/SotAScope/env

# UVICORN_BIN must be set in the env file.
# Find the right value with: conda run -n sotascope which uvicorn
ExecStart=${UVICORN_BIN} sotascope.app:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1

# Restart policy
Restart=on-failure
RestartSec=5s

# Give the process time to flush WAL on clean shutdown
TimeoutStopSec=30

# Logging goes to journald; view with: journalctl -u sotascope -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=sotascope

[Install]
WantedBy=multi-user.target
