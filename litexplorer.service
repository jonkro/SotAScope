[Unit]
Description=LitExplorer — research literature dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=litexplorer
Group=litexplorer

WorkingDirectory=/opt/litexplorer/LitExplorer

# Environment file for machine-specific paths, secrets, and proxy settings.
# Variables understood by this file:
#   UVICORN_BIN                                — full path to uvicorn in the conda env
#                                                (find with: conda run -n litexplorer which uvicorn)
#   HTTP_PROXY, HTTPS_PROXY, NO_PROXY          — corporate proxy (if any)
#   LITEXPLORER_DATA_DIR                       — persistent data root (DB, PDFs)
#   LITEXPLORER_OPENALEX_API_KEY               — polite-pool e-mail for OpenAlex
#   LITEXPLORER_CROSSREF_MAILTO                — polite-pool e-mail for Crossref
EnvironmentFile=/etc/litexplorer/env

# UVICORN_BIN must be set in /etc/litexplorer/env.
# Find the right value with: conda run -n litexplorer which uvicorn
ExecStart=${UVICORN_BIN} litexplorer.app:app \
    --host 0.0.0.0 \
    --port 8000 \
    --workers 1

# Restart policy
Restart=on-failure
RestartSec=5s

# Give the process time to flush WAL on clean shutdown
TimeoutStopSec=30

# Logging goes to journald by default; view with: journalctl -u litexplorer -f
StandardOutput=journal
StandardError=journal
SyslogIdentifier=litexplorer

[Install]
WantedBy=multi-user.target
